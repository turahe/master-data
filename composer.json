{
    "name": "turahe/master-data",
    "description": "Package Laravel yang berisi data Provinsi, Kabupaten/Kota, Kecamatan, dan Keluarahan/Desa di seluruh Master.",
    "keywords": [
        "laravel",
        "turahe",
        "address",
        "alamat",
        "indonesia",
        "provinsi",
        "kabupaten",
        "kota",
        "kecamatan",
        "kelurahan",
        "desa"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Nur Wachid",
            "email": "wachid@outlook.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "Turahe\\Master\\": "src/"
        },
        "files": [
            "src/Helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Turahe\\Master\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": "8.4.* || 8.5.*",
        "ext-json": "*",
        "laravel/framework": "^12.0|^13.0"

    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "spatie/geocoder": "^3.10|^4.0",
        "doctrine/dbal": "^4.1",
        "laravel/scout": "^10.11|^11.0",
        "laravel/pint": "^1.17",
        "spatie/eloquent-sortable": "^4.4|^5.0",
        "phpstan/phpstan": "^2.1"
    },
    "suggest": {
        "spatie/geocoder": "Synchronize latitude longitude data directly using Google's Geocoding Service"
    },
    "extra": {
        "laravel": {
            "providers": [
              "Turahe\\Master\\MasterServiceProvider"
            ],
            "aliases": {
                "Master": "Turahe\\Master\\MasterFacade"
            }
        }
    }
}
